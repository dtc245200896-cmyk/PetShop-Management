<%- include('header') %><section class="heading"><div><p class="eyebrow">QUẢN LÝ CỬA HÀNG</p><h1><%= title %></h1><p>Tra cứu và cập nhật thông tin <%= meta.singular %>.</p></div><a class="button" href="/<%= type %>/new">+ Thêm <%= meta.singular %></a></section><section class="panel"><form class="filters" method="get"><input name="q" aria-label="Tìm kiếm" value="<%= q %>" placeholder="<%= type==='services'?'Tìm mã hoặc tên dịch vụ':'Tìm mã, tên hoặc số điện thoại khách hàng' %>"><% if(type==='appointments'){ %><input type="date" name="day" value="<%= day %>" aria-label="Ngày hẹn"><select name="status" aria-label="Trạng thái"><option value="">Mọi trạng thái</option><% for(const [k,v] of Object.entries(statuses)){ %><option value="<%= k %>" <%= status===k?'selected':'' %>><%= v %></option><% } %></select><% } %><button>Tìm kiếm</button><a class="secondary" href="/<%= type %>">Xóa lọc</a></form><p><%= rows.length %> kết quả (tối đa 500)</p><div class="table-wrap"><table><thead><tr><th>Mã</th><th><%= type==='appointments'?'Thú cưng':'Tên' %></th><th>Thông tin</th><th>Thao tác</th></tr></thead><tbody><% rows.forEach(row=>{ %><tr><td><a href="/<%= type %>/<%= row.id %>"><%= row.code %></a></td><td><b><%= row.name||row.pet_name %></b><small><%= row.owner_name||'' %></small></td><td><% if(type==='customers'){ %><%= row.phone %><small><%= row.email||'' %></small><% }else if(type==='pets'){ %><%= row.species %> · <%= row.breed||'Chưa ghi giống' %><small><%= row.owner_phone %></small><% }else if(type==='services'){ %><%= money(row.price) %><small><%= row.duration_minutes %> phút</small><% }else{ %><%= time(row.starts_at) %><small><%= row.service_name %> · <%= statuses[row.status] %></small><% } %></td><td class="actions"><a href="/<%= type %>/<%= row.id %>">Chi tiết</a><a href="/<%= type %>/<%= row.id %>/edit">Sửa</a><form method="post" action="/<%= type %>/<%= row.id %>/delete" data-confirm="Xóa bản ghi này? Dữ liệu liên quan sẽ được bảo vệ."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="danger">Xóa</button></form></td></tr><% }) %><% if(!rows.length){ %><tr><td colspan="4" class="empty">Không có dữ liệu phù hợp. Thử đổi điều kiện tìm kiếm hoặc thêm bản ghi.</td></tr><% } %></tbody></table></div></section><%- include('footer') %>
