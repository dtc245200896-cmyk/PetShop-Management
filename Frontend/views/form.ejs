<%- include('header') %><section class="heading"><div><p class="eyebrow"><%= meta.title %></p><h1><%= title %></h1></div><a class="secondary" href="/<%= type %>">← Danh sách</a></section><section class="panel form-panel"><% if(error){ %><div class="error" role="alert"><%= error %></div><% } %><form method="post" action="/<%= type %><%= record.id?'/'+record.id:'' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="form-grid"><% for(const [key,label,kind='text'] of meta.fields){ let value=record[key]??''; if(value && (kind==='date'||kind==='datetime-local') && value instanceof Date){value=kind==='date'?value.toISOString().slice(0,10):new Date(+value+7*3600000).toISOString().slice(0,16);} %><label class="<%= kind==='textarea'?'wide':'' %>"><span><%= label %></span><% if(options[kind]||kind==='status'){ %><select name="<%= key %>" required><% if(kind==='status'){for(const [k,v] of Object.entries(statuses)){ %><option value="<%= k %>" <%= value===k?'selected':'' %>><%= v %></option><% }}else{ %><option value="">Chọn <%= label.toLowerCase() %></option><% options[kind].forEach(o=>{ %><option value="<%= o.id %>" <%= String(value)===String(o.id)?'selected':'' %>><%= o.code %> — <%= o.name %><%= o.owner_name?' / '+o.owner_name+' / '+o.owner_phone:'' %><%= kind==='services'?' / '+money(o.price)+' / '+o.duration_minutes+' phút':'' %></option><% });} %></select><% }else if(kind==='textarea'){ %><textarea name="<%= key %>" rows="4" maxlength="2000"><%= value %></textarea><% }else{ %><input name="<%= key %>" type="<%= kind %>" value="<%= value %>" <%= ['code','name','phone','species','price','duration_minutes','starts_at'].includes(key)?'required':'' %> <%= kind==='number'?'min=0 step=any':'' %> maxlength="<%= key==='phone'?15:key==='code'?20:250 %>"><% } %></label><% } %></div><% if(type==='appointments'){ %><p class="hint">Chọn thú cưng theo chủ sở hữu. Giá và thời lượng được lưu theo dịch vụ khi đặt; hệ thống kiểm tra trùng lịch của cùng thú cưng. Giờ hẹn theo Việt Nam.</p><% } %><div class="form-actions"><button>Lưu thông tin</button><a class="secondary" href="/<%= type %>">Hủy</a></div></form></section><%- include('footer') %>
