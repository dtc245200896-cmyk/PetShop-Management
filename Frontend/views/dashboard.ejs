<%- include('header') %><section class="heading"><div><p class="eyebrow">CHÀO MỪNG ĐẾN PETSHOP</p><h1>Tổng quan cửa hàng</h1><p>Theo dõi khách hàng, thú cưng và lịch chăm sóc.</p></div><a class="button" href="/appointments/new">+ Đặt lịch hẹn</a></section><div class="cards"><% for(const [key,n] of Object.entries(counts)){ %><a class="card" href="/<%= key %>"><span><%= entities[key].title %></span><strong><%= n %></strong><small>Xem danh sách →</small></a><% } %></div><section class="panel"><h2>Lịch hẹn gần đây</h2><p>Thời gian hiển thị theo múi giờ Việt Nam.</p><div class="table-wrap"><table><thead><tr><th>Mã</th><th>Thú cưng / Khách hàng</th><th>Dịch vụ</th><th>Thời gian</th><th>Trạng thái</th></tr></thead><tbody><% appointments.slice(0,8).forEach(a=>{ %><tr><td><a href="/appointments/<%= a.id %>"><%= a.code %></a></td><td><b><%= a.pet_name %></b><small><%= a.owner_name %></small></td><td><%= a.service_name %></td><td><%= time(a.starts_at) %></td><td><span class="badge <%= a.status %>"><%= statuses[a.status] %></span></td></tr><% }) %><% if(!appointments.length){ %><tr><td colspan="5">Chưa có lịch hẹn. Hãy tạo lịch đầu tiên.</td></tr><% } %></tbody></table></div></section><%- include('footer') %>
