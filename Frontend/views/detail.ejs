<%- include('header') %><section class="heading"><div><p class="eyebrow">CHI TIẾT <%= meta.singular.toUpperCase() %></p><h1><%= record.name||record.code %></h1></div><a class="button" href="/<%= type %>/<%= record.id %>/edit">Sửa thông tin</a></section><section class="panel"><dl><% for(const [key,label] of meta.fields){let value=record[key]; if(key==='status')value=statuses[value];if(key==='starts_at')value=time(value);if(key==='price')value=money(value);if(key==='customer_id')value=record.owner_name;if(key==='pet_id')value=record.pet_name+' / '+record.owner_name;if(key==='service_id')value=record.service_name;if(key==='birth_date'&&value)value=new Date(value).toLocaleDateString('vi-VN'); %><div><dt><%= label %></dt><dd><%= value??'Chưa cung cấp' %></dd></div><% } %><% if(type==='appointments'){ %><div><dt>Giá tại thời điểm đặt</dt><dd><%= money(record.price) %></dd></div><div><dt>Kết thúc dự kiến</dt><dd><%= time(record.ends_at) %></dd></div><% } %></dl><a class="secondary" href="/<%= type %>">← Quay lại danh sách</a></section><%- include('footer') %>
